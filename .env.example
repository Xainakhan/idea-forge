# Keep this file public. Put real secrets in .env (which is gitignored).
# OpenRouter free routing: generate a key at openrouter.ai/keys.
OPENROUTER_API_KEY=
IDEALIST_MODEL=openrouter/openrouter/free
# The free router does not provide a dependable embedding model. Exact-title and
# recent-history duplicate protection remain active.
IDEALIST_ENABLE_EMBEDDINGS=false
IDEALIST_MAX_RECENT_IDEAS=20
CORS_ORIGINS=http://localhost:3000
